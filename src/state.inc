; The game's state: the same bytes, with the same meanings, at the same addresses as the 2600 kept them
; (zero page $80-$FF), so the check can compare them with the remaster's model frame by frame. The
; remaster's game/ram_map.py and docs/spec.md ("The state") say what each one means.

death_timer     = $80   ; $FF when caught, counts down while the eyes roll
drop_tries      = $81   ; the drop search: 5 when an item is put down, counts down
matches_used    = $82   ; two decimal digits: the score
monsters_here   = $83   ; monsters in the player's room (or the room beyond the doorway)
colour_cycle    = $84   ; bit 4: attract mode, the colours drift
monster_shown   = $85   ; whose turn it was to be drawn: a monster, or the stairs after the last
item_shown      = $86   ; the item drawn last
second_counter  = $87   ; frames until the match loses a second
doorway         = $88   ; bit 7: in a doorway; low bits: which way
clock           = $89   ; +1 every frame
flags           = $8A   ; bit 7: the monsters' turn; bit 6: a match lit; bit 0: won
room_top        = $8B   ; the room's limits, for the match's light
room_bottom     = $8C
floor           = $8D   ; 0-3
joystick        = $8E   ; read last frame: bit 7 right, 6 left, 5 down, 4 up
thunder         = $8F   ; frames left of this rumble, while dying
sound_time      = $90   ; frames left of the sound effect
blocked         = $91   ; bit 6 stops moving across, bit 7 up and down (a locked door)
mood_direction  = $92   ; the monster noise: rising or falling
sound           = $93   ; the sound effect playing
following       = $94   ; a bit per monster sent after the player
arrived         = $95   ; a bit per monster at its waypoint
lives           = $96
room_beyond     = $97   ; in a doorway, the room on the other side; $FF otherwise
mood_pitch      = $98   ; the monster noise's pitch; $7F silent
game_state      = $99   ; see the GAME_ constants
carried         = $9A   ; an item, or $FF
stairs          = $9B   ; this room's stairs: edge + 4 if up, $0F none; bit 7 at the edge, bit 6 just used
room            = $9C   ; 0-5
urn_shapes      = $9D   ; three bytes: the shapes of items 2, 3, 4
item_floor      = $A0   ; five bytes each, by item
monster_floor   = $A5   ; five bytes each, by monster
player_x        = $AA
item_x          = $AB
monster_x       = $B0
player_y        = $B5
item_y          = $B6
monster_y       = $BB
monster_route   = $C0   ; each monster's plan: direction << 6 | kind << 4 | target
monster_room    = $C5
killed_by       = $CA
eyes_line       = $CB   ; the screen line the eyes are on
game_number     = $CC   ; 0-8
mask_x          = $CF   ; where two blocks go in the middle wall's gap (never seen in play)
sprite_x        = $DC   ; this frame's sprite: its column...
mask_x_2        = $DE
match_time      = $DF   ; seconds left on the match
sprite_pointer  = $E1   ; ...its shape's address ($FExx, as the 2600's)...
select_delay    = $E5   ; frames until SELECT steps the game again
button_history  = $E6   ; the button over the last 8 frames, a bit each (0 = pressed)
step_x          = $E7   ; this frame's tried step: 1, 0 or $FF
step_y          = $E8
dropped         = $E9   ; the item being put down
last_monster    = $EA   ; 2 or 4
random_low      = $EB   ; the random numbers: a 16-bit shift register
random_high     = $EC
sprite_height   = $ED   ; ...its height...
sprite_line     = $EF   ; ...and the line of its bottom row

; working bytes the 2600 used for drawing, free here between routines (never compared)
work_0 = $D0
work_1 = $D1
work_2 = $D2
work_3 = $D3
work_4 = $D4
work_5 = $D5
work_6 = $D6
work_7 = $D7
work_8 = $D8
work_9 = $D9
work_10 = $DA
work_11 = $DB

; --- values the game gives its bytes --------------------------------------------------------------------
GAME_PLAYING    = $00
GAME_DYING      = $01
GAME_JUST_RESET = $02
GAME_SELECTING  = $40
GAME_WON        = $44
NO_PLAY         = $43   ; game_state bits that stop the player moving
NO_LOGIC        = $40   ; the bit that stops everything after the picture
WON_BIT         = $04
MONSTER_TURN    = $80
MATCH_LIT       = $40
WON_FLAG        = $01
KEEP_ON_MATCH_OUT = $07
NO_STAIRS       = $0F
AT_EDGE         = $80
JUST_USED_STAIRS = $40
GOES_UP         = $04
IN_DOORWAY      = $80
NOTHING         = $FF
KEY             = 0
SCEPTER         = 1
URN             = 2
WHOLE_URN       = 8
JOINED          = $FF
GHOST           = 0
BAT             = 1
ATTRACT         = $10
PRESSED         = $7F   ; button_history for a press: pressed now, up for the 7 frames before
MATCH_SECONDS   = 20
FRAMES_PER_SECOND = 60
SELECT_REPEAT   = 45
GAME_COUNT      = 9
GAME_3          = 2
GAME_9          = 8
FIRST_LOCKED_GAME = 2
FIRST_FIVE_MONSTER_GAME = 4
FIRST_FOLLOW_GAME = 5
FIRST_THEFT_GAME = 6
FIRST_FAST_GAME = 7
DROP_SEARCH     = 5
DROP_UP         = $0A
ITEM_REACH      = $11
VIEW_LINES      = $50
LAST_LINE_BELOW = $F9
TOP_LINE        = 79
MIDDLE_SCREEN_LINE = $26
SCROLL_STOPS    = $D7
SCROLL_TOP_OFFSET = $AF
EDGE_STRIP      = 4
SCREEN_WIDTH    = 160
SHAPES_PAGE     = $FE   ; the high byte of every shape's address, as on the 2600
ITEM_SHAPES     = $08   ; where the item shapes start in the page
MONSTER_SHAPES  = $50
STAIRS_SHAPES   = $8C
SHAPE_HEIGHT_ITEM = 8
SHAPE_HEIGHT_MONSTER = 10
SHAPE_HEIGHT_STAIRS = 17
MONSTER_SECOND_FRAME = 10
WANDER_FRAMES   = $88   ; the frames of 8 a wandering monster steps on: 3 and 7
LOST_RETURNS_TO_CRASH = 5

; the stick, as joystick holds it (1 = pushed)
STICK_RIGHT = $80
STICK_LEFT  = $40
STICK_DOWN  = $20
STICK_UP    = $10

; sound effects
SOUND_BLOCKED   = 2
SOUND_BUMP      = 3
SOUND_DOORWAY   = 4
SOUND_DROP      = 5
SOUND_PICK_UP   = 6
SOUND_JOIN      = 7
SOUND_NEW_ROOM  = 8
SOUND_STAIRS_UP = 9
SOUND_STAIRS_DOWN = 10
SOUND_URN_WHOLE = 11
MOOD_SILENT     = $7F
